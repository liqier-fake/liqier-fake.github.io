---
import { sitePath } from '../../lib/sitePath';
---

<nav class="entrance-layer" data-entrance-layer aria-label="月见世界入口">
  <a class="entrance entrance--slip" data-world-entrance data-entrance-id="paper-slip:first-light" data-entrance-scene="paper-slip" data-entrance-state="distant" href={sitePath('/thoughts/first-light/')}>
    <span aria-hidden="true">一枚发光纸笺</span><strong>感悟</strong>
  </a>
  <a class="entrance entrance--pavilion" data-world-entrance data-entrance-id="essay-pavilion:after-the-long-night" data-entrance-scene="essay-pavilion" data-entrance-state="distant" href={sitePath('/articles/after-the-long-night/')}>
    <span aria-hidden="true">灯火仍亮的亭子</span><strong>文章</strong>
  </a>
  <a class="entrance entrance--corridor" data-world-entrance data-entrance-id="image-corridor:moonlit-water" data-entrance-scene="image-corridor" data-entrance-state="distant" href={sitePath('/photography/moonlit-water/')}>
    <span aria-hidden="true">悬浮的影像回廊</span><strong>照片</strong>
  </a>
  <a class="entrance entrance--tree" data-world-entrance data-entrance-id="moon-tree:borrowed-light" data-entrance-scene="moon-tree" data-entrance-state="distant" href={sitePath('/collection/borrowed-light/')}>
    <span aria-hidden="true">月光树下的拾取物</span><strong>收藏</strong>
  </a>
  <a class="entrance entrance--platform" data-world-entrance data-entrance-id="central-platform:about" data-entrance-scene="central-platform" data-entrance-state="distant" href="#about">
    <span aria-hidden="true">中央水镜</span><strong>关于</strong>
  </a>
</nav>

<script>
  import { mountEntranceLayer } from '../../lib/world/entrances';
  const layer = document.querySelector<HTMLElement>('[data-entrance-layer]');
  if (layer) mountEntranceLayer(layer);
</script>

<style>
  .entrance-layer { position: fixed; inset: 0; z-index: 4; pointer-events: none; }
  .entrance { position: absolute; display: grid; min-width: 7.5rem; min-height: 44px; place-content: center; gap: .28rem; padding: .65rem 1rem; color: var(--ink); text-align: center; text-decoration: none; pointer-events: auto; opacity: 0; visibility: hidden; filter: blur(.4px); transform: translateY(8px) scale(.94); transition: opacity .35s ease, transform .35s ease, filter .35s ease, text-shadow .35s ease; }
  .entrance span { color: var(--ink-muted); font: 400 .62rem/1.2 var(--font-ui); letter-spacing: .08em; }
  .entrance strong { font: 500 .78rem/1 var(--font-ui); letter-spacing: .22em; }
  .entrance[data-entrance-state="near"], .entrance[data-entrance-state="focused"] { opacity: .92; visibility: visible; filter: none; transform: none; }
  .entrance[data-entrance-state="focused"] { opacity: 1; text-shadow: 0 0 18px var(--lantern-amber), 0 0 34px #8eb9df; }
  .entrance[data-entrance-state="entering"] { opacity: 0; transform: scale(1.12); }
  .entrance--slip { left: 8vw; top: 42%; transform-origin: left center; }
  .entrance--pavilion { right: 12vw; top: 31%; }
  .entrance--corridor { right: 6vw; bottom: 21%; }
  .entrance--tree { left: 13vw; bottom: 17%; }
  .entrance--platform { left: 50%; top: 57%; translate: -50% -50%; }
  /* pinned to its object in the world: the label floats above a thin stem that touches the object */
  .entrance[data-anchored] { right: auto; bottom: auto; translate: -50% calc(-100% - 26px); }
  .entrance[data-anchored]::after {
    content: ''; position: absolute; left: 50%; top: 100%; width: 1px; height: 22px;
    background: linear-gradient(rgba(220, 233, 243, .7), rgba(220, 233, 243, 0));
  }
  .entrance[data-anchored]::before {
    content: ''; position: absolute; left: 50%; top: calc(100% + 22px); width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px;
    border-radius: 50%; background: var(--pearl-silver); box-shadow: 0 0 12px 2px rgba(241, 166, 90, .8);
  }
  .entrance[data-anchored][data-entrance-state="focused"]::before { background: var(--lantern-amber); }
  @media (max-width: 600px) {
    .entrance { min-width: 5.5rem; padding-inline: .5rem; }
    .entrance span { display: none; }
    .entrance--pavilion { right: 4vw; }
    .entrance--tree { left: 4vw; }
  }
  @media (prefers-reduced-motion: reduce) { .entrance { transition: opacity .01ms; } }
</style>
