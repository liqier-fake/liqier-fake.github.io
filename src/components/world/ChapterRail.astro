---
const chapters = ['序', '朱门', '灯亭', '回廊', '水镜', '终'];
---

<ol class="rail" data-chapter-rail aria-hidden="true">
  {chapters.map((name, i) => (
    <li data-rail-index={i}><span class="rail-name">{name}</span><span class="rail-tick"></span></li>
  ))}
</ol>

<script>
  import { watchChapters } from '../../lib/ui/chapters';
  const rail = document.querySelector<HTMLElement>('[data-chapter-rail]');
  if (rail) {
    const items = Array.from(rail.querySelectorAll<HTMLElement>('[data-rail-index]'));
    watchChapters((index) => items.forEach((item, i) => item.classList.toggle('is-on', i === index)));
  }
</script>

<style>
  .rail { position: fixed; z-index: 6; right: clamp(1rem, 2.6vw, 2.4rem); top: 50%; translate: 0 -50%; margin: 0; padding: 0; list-style: none; display: grid; gap: .95rem; pointer-events: none; }
  .rail li { display: flex; align-items: center; justify-content: flex-end; gap: .8rem; height: 10px; }
  .rail-tick { width: 14px; height: 1px; background: rgba(220, 233, 243, .3); transition: width .6s cubic-bezier(.16, 1, .3, 1), background .6s; }
  .rail-name { color: var(--pearl-silver); font: 500 .62rem/1 var(--font-ui); letter-spacing: .28em; opacity: 0; translate: 6px 0; transition: opacity .5s, translate .6s cubic-bezier(.16, 1, .3, 1); text-shadow: 0 1px 12px #02060c; }
  .rail li.is-on .rail-tick { width: 30px; background: var(--pearl-silver); }
  .rail li.is-on .rail-name { opacity: .9; translate: 0 0; }
  @media (max-width: 720px) { .rail { display: none; } }
</style>
