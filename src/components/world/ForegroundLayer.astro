---
import { sitePath } from '../../lib/sitePath';

/**
 * The near plane: transparent cut-outs standing between the camera and the live world.
 * Each chapter owns a small set; pieces rise from the edge they are anchored to when
 * their chapter takes the viewport, and sink back when it leaves.
 */
type Edge = 'bottom' | 'top';
interface Piece { src: string; w: number; h: number; edge: Edge; side: 'left' | 'right'; width: string; offset: string; flip?: boolean; depth: number; }

const sets: Record<number, Piece[]> = {
  0: [
    { src: 'sakura-branch', w: 1400, h: 933, edge: 'top', side: 'right', width: 'clamp(320px, 40vw, 760px)', offset: '-3vw', flip: true, depth: 1.2 },
    { src: 'reeds', w: 1400, h: 643, edge: 'bottom', side: 'right', width: 'clamp(420px, 52vw, 1000px)', offset: '-6vw', depth: 1.6 },
    { src: 'shore-rocks', w: 1400, h: 504, edge: 'bottom', side: 'left', width: 'clamp(300px, 34vw, 640px)', offset: '-5vw', depth: 1.4 },
  ],
  1: [
    { src: 'stone-lantern', w: 718, h: 1400, edge: 'bottom', side: 'left', width: 'clamp(150px, 15vw, 290px)', offset: '4vw', depth: 1.3 },
    { src: 'pine', w: 954, h: 1400, edge: 'bottom', side: 'left', width: 'clamp(220px, 24vw, 460px)', offset: '-9vw', depth: 0.9 },
  ],
  2: [
    { src: 'paper-lanterns', w: 1400, h: 933, edge: 'top', side: 'right', width: 'clamp(320px, 40vw, 720px)', offset: '2vw', depth: 0.8 },
    { src: 'shore-rocks', w: 1400, h: 504, edge: 'bottom', side: 'right', width: 'clamp(320px, 38vw, 700px)', offset: '-7vw', depth: 1.5 },
  ],
  3: [
    { src: 'maple-leaves', w: 1225, h: 882, edge: 'top', side: 'left', width: 'clamp(300px, 34vw, 640px)', offset: '-4vw', flip: true, depth: 1.1 },
    { src: 'reeds', w: 1400, h: 643, edge: 'bottom', side: 'left', width: 'clamp(380px, 44vw, 860px)', offset: '-8vw', depth: 1.6 },
  ],
  4: [
    { src: 'sakura-branch', w: 1400, h: 933, edge: 'top', side: 'left', width: 'clamp(260px, 28vw, 520px)', offset: '-6vw', depth: 1.2 },
  ],
  5: [
    { src: 'pine', w: 954, h: 1400, edge: 'bottom', side: 'right', width: 'clamp(200px, 22vw, 420px)', offset: '-6vw', flip: true, depth: 0.9 },
    { src: 'reeds', w: 1400, h: 643, edge: 'bottom', side: 'left', width: 'clamp(360px, 40vw, 780px)', offset: '-8vw', depth: 1.5 },
  ],
};
---

<div class="fg" data-foreground aria-hidden="true">
  {Object.entries(sets).map(([chapter, pieces]) => (
    <div class="fg-stage" data-fg-stage={chapter}>
      {pieces.map((piece, i) => (
        <div
          class={`fg-piece fg-piece--${piece.edge}`}
          style={`${piece.side}:${piece.offset};${piece.edge}:-2vh;width:${piece.width};--i:${i};--depth:${piece.depth}`}
          data-depth={piece.depth}
        >
          <img
            data-src={sitePath(`/images/foreground/${piece.src}.webp`)}
            alt=""
            width={piece.w}
            height={piece.h}
            decoding="async"
            style={piece.flip ? 'transform:scaleX(-1)' : undefined}
          />
        </div>
      ))}
    </div>
  ))}
</div>

<script>
  import { watchChapters } from '../../lib/ui/chapters';

  const layer = document.querySelector<HTMLElement>('[data-foreground]');
  if (layer) {
    const stages = new Map(Array.from(layer.querySelectorAll<HTMLElement>('[data-fg-stage]')).map((s) => [Number(s.dataset.fgStage), s]));
    const load = (index: number): void => {
      stages.get(index)?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.src = img.dataset.src ?? '';
        img.removeAttribute('data-src');
      });
    };
    watchChapters((index) => {
      load(index);
      load(index + 1);
      stages.forEach((stage, key) => stage.classList.toggle('is-live', key === index));
    });

    // Pointer parallax: nearer pieces (higher depth) travel further.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const tick = (): void => {
        x += (tx - x) * 0.06;
        y += (ty - y) * 0.06;
        layer.style.setProperty('--px', x.toFixed(4));
        layer.style.setProperty('--py', y.toFixed(4));
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0;
      };
      window.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse') return;
        tx = event.clientX / innerWidth - 0.5;
        ty = event.clientY / innerHeight - 0.5;
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });
    }
  }
</script>

<style>
  .fg { position: fixed; inset: 0; z-index: 1; overflow: hidden; pointer-events: none; --px: 0; --py: 0; }
  .fg-stage { position: absolute; inset: 0; visibility: hidden; transition: visibility 0s linear 1.1s; }
  .fg-stage.is-live { visibility: visible; transition-delay: 0s; }
  .fg-piece {
    position: absolute; opacity: 0;
    translate: calc(var(--px) * var(--depth) * -26px) calc(var(--py) * var(--depth) * -14px);
    transition: opacity .9s cubic-bezier(.16, 1, .3, 1), transform 1.3s cubic-bezier(.16, 1, .3, 1);
    transition-delay: 0s;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, .45));
  }
  .fg-piece--bottom { transform: translate3d(0, 34%, 0); }
  .fg-piece--top { transform: translate3d(0, -34%, 0); }
  .fg-stage.is-live .fg-piece { opacity: 1; transform: none; transition-delay: calc(var(--i) * 90ms + 120ms); }
  .fg-piece img { display: block; width: 100%; height: auto; }

  @media (max-width: 720px) {
    .fg-piece { opacity: 0; }
    .fg-stage.is-live .fg-piece { opacity: .9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fg-piece, .fg-piece--bottom, .fg-piece--top { transform: none; translate: none; transition: opacity .3s linear; }
  }
</style>
