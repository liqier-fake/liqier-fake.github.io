---
import SiteMap from '../components/accessibility/SiteMap.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/sitePath';
---

<SiteLayout title="内容地图 · liqier-fake" description="不依赖 3D 场景的完整内容入口" worldView="reading">
  <section class="map-page">
    <a href={sitePath('/')} class="back">← 返回月见世界</a>
    <header><p>另一条路</p><h1>内容地图</h1><p>如果不想穿过 3D 世界，也可以从这里直接抵达所有文字与影像。</p></header>
    <SiteMap />
  </section>
</SiteLayout>

<style>
  .map-page { position: relative; z-index: 5; min-height: 100vh; padding: 8rem clamp(1rem, 7vw, 7rem); background: rgba(7,20,37,.72); backdrop-filter: blur(14px); }
  header { width: min(70rem, 100%); margin: 0 auto 5rem; } header > p:first-child { color: var(--lantern-amber); font: 500 .72rem/1 var(--font-ui); letter-spacing: .2em; }
  h1 { margin: .5rem 0; font-size: clamp(3.5rem, 10vw, 8rem); font-weight: 400; }
  .back { position: absolute; top: 1.5rem; left: clamp(1rem, 4vw, 3rem); min-height: 44px; display: flex; align-items: center; font: 500 .72rem/1 var(--font-ui); letter-spacing: .14em; text-decoration: none; }
</style>
